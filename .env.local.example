# Copie para .env.local (uso LOCAL). No Firebase App Hosting não precisa: a configuração chega sozinha.
# Os valores vêm de:
# Firebase Console > Project settings (engrenagem) > General > Your apps > Web app > SDK setup and configuration.
# Esses valores não são segredos; a segurança está nas regras do Firestore (firestore.rules).

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
